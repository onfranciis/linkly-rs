ROCKET_PORT=8000
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://<username>:<password>@127.0.0.1:5432/linkly_rs

# NOTE
# - DATABASE_URL must always point to a live, reachable database — sqlx uses it to validate query macros at compile time.
# - Avoid spaces and/or quotes in your .env file; it can cause issues with Docker setups.
